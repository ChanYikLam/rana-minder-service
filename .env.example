# RanaMinder 配置示例（ADR-010 单文件外置配置 + Docker 只读挂载约定）
#
# 本文件不包含真实密钥、连接信息或生产域名；提交到版本控制。
# 真实部署配置应通过 /etc/ranaminder/config.yaml 或环境变量注入。
#
# 加载顺序：
#   1. RANAMINDER_CONFIG_FILE 指定的 YAML 文件（默认 /etc/ranaminder/config.yaml）
#   2. 本文件列出的环境变量覆盖同名键
#   3. 缺失时回落到 loader 内置默认值（仅开发/测试场景）
#
# 秘密字段一律以引用形式出现：
#   - ${env:VAR_NAME}          从环境变量读取
#   - ${file:/path/to/secret}  从白名单路径读取（/etc/ranaminder/secrets/、/run/secrets/）

# -------- 开发安全桩（fail-closed；非 production 亦须显式开启） --------
ORG_DEV_ACTOR_HEADER=1

# -------- HTTP 服务 --------
PORT=3000
HOST=0.0.0.0
GRACEFUL_SHUTDOWN_TIMEOUT_MS=10000

# -------- 数据库（ADR-014 单库单 Schema） --------
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=ranaminder
DATABASE_USER=ranaminder
DATABASE_SCHEMA=app
DATABASE_SSL=false
DATABASE_PASSWORD_REF=${env:DATABASE_PASSWORD}

# -------- Casdoor（ADR-009 v3.108.0） --------
CASDOOR_ENDPOINT=https://casdoor.example.edu
CASDOOR_CLIENT_ID=replace-me
CASDOOR_CLIENT_SECRET_REF=${env:CASDOOR_CLIENT_SECRET}
CASDOOR_ORGANIZATION=replace-me
CASDOOR_REDIRECT_URI=http://localhost:3000/api/auth/callback

# -------- 对象存储（ADR-008 S3 兼容；DATA-Q-012 三个私有 Bucket） --------
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY_REF=${env:STORAGE_ACCESS_KEY}
STORAGE_SECRET_KEY_REF=${env:STORAGE_SECRET_KEY}
STORAGE_BUCKET_QUARANTINE=ranaminder-quarantine
STORAGE_BUCKET_PRIMARY=ranaminder-primary
STORAGE_BUCKET_DERIVED=ranaminder-derived

# -------- 邮件 --------
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_FROM_ADDRESS=no-reply@example.edu
# MAIL_USER_REF=${env:MAIL_USER}            # 可选
# MAIL_PASSWORD_REF=${env:MAIL_PASSWORD}    # 可选

# -------- 观测（ADR-011 内置最小观测） --------
LOG_LEVEL=info
TRACE_SAMPLING_RATE=1.0

# -------- 后台任务（ADR-004 持久任务可靠投递） --------
JOB_SCHEDULER_INTERVAL_MS=1000
JOB_DEFAULT_LEASE_MS=60000
JOB_MAX_ATTEMPTS=5