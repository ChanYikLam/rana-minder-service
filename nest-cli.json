{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "tsConfigPath": "tsconfig.build.json"
  },
  "entryFile": "main",
  "projects": {
    "ranaminder-service": {
      "type": "application",
      "root": "src",
      "entryFile": "main",
      "sourceRoot": "src",
      "compilerOptions": {
        "tsConfigPath": "tsconfig.build.json",
        "deleteOutDir": true
      }
    },
    "ranaminder-worker": {
      "type": "application",
      "root": "src",
      "entryFile": "main.worker",
      "sourceRoot": "src",
      "compilerOptions": {
        "tsConfigPath": "tsconfig.build.json",
        "deleteOutDir": true
      }
    }
  }
}
