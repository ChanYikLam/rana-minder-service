{
  "name": "ranaminder-service",
  "version": "0.0.0",
  "description": "高校学生社团人员管理系统 · 后端服务（NestJS + TypeScript，按 ADR-001 / ADR-013 / ADR-014）",
  "private": true,
  "license": "MIT",
  "type": "commonjs",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.34.5"
  },
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "build": "nest build",
    "build:all": "nest build",
    "build:worker": "nest build ranaminder-worker",
    "start": "node dist/main.js",
    "start:worker": "node dist/main.worker.js",
    "migrate": "node -r ts-node/register src/database/migrate.ts",
    "start:dev": "nest start --watch",
    "start:dev:worker": "nest start --watch --entryFile main.worker",
    "lint": "eslint \"{src,test,apps,packages}/**/*.ts\"",
    "lint:fix": "eslint \"{src,test,apps,packages}/**/*.ts\" --fix",
    "format": "prettier --write \"{src,test,apps,packages}/**/*.{ts,json,md}\"",
    "format:check": "prettier --check \"{src,test,apps,packages}/**/*.{ts,json,md}\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --env-file=.env.test --test --test-concurrency=8 -r ts-node/register \"src/**/*.spec.ts\" \"test/*.spec.ts\"",
    "test:unit": "node --env-file=.env.test --test --test-concurrency=8 -r ts-node/register \"src/**/*.spec.ts\" \"test/*.spec.ts\"",
    "test:integration": "node --env-file=.env.test --test --test-concurrency=1 -r ts-node/register \"test/integration/**/*.spec.ts\"",
    "test:contract": "node --env-file=.env.test --test -r ts-node/register \"test/contract/**/*.spec.ts\"",
    "test:l5": "node --env-file=.env.test --test --test-concurrency=4 -r ts-node/register \"test/nfr/**/*.spec.ts\" \"test/ops/**/*.spec.ts\" \"test/casdoor/**/*.spec.ts\" \"test/data/**/*.spec.ts\" \"test/security/**/*.spec.ts\"",
    "coverage:all": "node --env-file=.env.test --test --test-concurrency=8 -r ts-node/register \"src/**/*.spec.ts\" \"test/*.spec.ts\"",
    "test:cov": "c8 -o coverage -- npm run coverage:all",
    "test:cov:gate": "node scripts/ci/coverage-gate.js",
    "test:cov:baseline": "node scripts/ci/coverage-baseline.js",
    "api:openapi": "node scripts/generate-openapi.js"
  },
  "c8": {
    "include": [
      "src/**/*.ts"
    ],
    "exclude": [
      "**/*.spec.ts",
      "src/shared/testing/**",
      "src/database/migrations/**"
    ],
    "reporter": [
      "text",
      "text-summary",
      "json-summary"
    ]
  },
  "dependencies": {
    "@nestjs/common": "^11.2.1",
    "@nestjs/core": "^11.2.1",
    "@nestjs/platform-express": "^11.2.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "jose": "^6.2.10",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "yaml": "^2.6.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.23.1",
    "c8": "^12.0.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "ts-node": "^10.9.2",
    "typescript": "~5.7.0",
    "typescript-eslint": "^8.67.0"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": []
    }
  }
}
