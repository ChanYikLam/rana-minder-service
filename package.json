{
  "name": "ranaminder-service",
  "version": "0.1.0",
  "description": "RanaMinder 高校学生社团人员管理系统后端服务",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "build:worker": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "start:worker": "node dist/worker",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"package.json\" \"tsconfig*.json\"",
    "test": "node --test -r ts-node/register \"src/platform/read-model/**/*.spec.ts\"",
    "test:unit": "node --test -r ts-node/register \"src/platform/read-model/**/*.spec.ts\"",
    "test:integration": "node --test -r ts-node/register \"test/integration/**/*.spec.ts\"",
    "test:contract": "node --test -r ts-node/register \"test/contract/**/*.spec.ts\""
  },
  "dependencies": {
    "@nestjs/common": "^11.2.1",
    "@nestjs/core": "^11.2.1",
    "@nestjs/platform-express": "^11.2.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.67.0"
  }
}
